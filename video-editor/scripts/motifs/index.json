{
  "_doc": "Motif registry — parameterized scene types, one implementation per engine, selected by name from config/scenes.json. See docs/design/scenes-as-data.md and ./README.md. `kind`: scene = drawn over everything · overlay = drawn on the video card. `bottom`: nominal graphic-bottom y in the 1080x1920 space, feeds the DOWN flex rect (a scene's layout.gb overrides). `params`: a shallow shape hint (number | string | number[] | string[] | boolean) — not JSON Schema; values are hand-authored. `status`: implemented | planned.",

  "motifs": {
    "stamp": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 400,
      "from": "stamp",
      "params": { "text": "string", "lead": "string", "rotation": "number", "ring": "boolean" }
    },
    "counter": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 520,
      "from": "price",
      "params": { "title": "string", "from": "number", "to": "number", "prefix": "string", "suffix": "string", "decimals": "number", "settleAt": "number", "scramble": "boolean" }
    },
    "quote": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 260,
      "from": "titleChip",
      "params": { "text": "string", "accent": "boolean", "y": "number" }
    },
    "checklist": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 640,
      "from": "rtlFix (row reveal)",
      "params": { "title": "string", "items": "string[]", "tick": "string", "y": "number" }
    },
    "card-stack": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 520,
      "from": "chips, cardStack",
      "params": { "items": "string[]", "columns": "number", "checkmark": "boolean", "flipAt": "number" }
    },
    "transcript-panel": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 600,
      "from": "transcript",
      "params": { "title": "string", "lines": "string[]" }
    },
    "file-merge": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 580,
      "from": "fileToCloud, oneFile",
      "params": { "sources": "string[]", "targetLabel": "string", "note": "string", "done": "string" }
    },
    "glitch": {
      "status": "implemented",
      "kind": "overlay",
      "bottom": 0,
      "from": "glitch",
      "params": { "intensity": "number", "slices": "number" }
    },
    "comment-box": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 1244,
      "from": "commentBox",
      "params": { "word": "string", "placeholder": "string" }
    },
    "sync-viz": {
      "status": "implemented",
      "kind": "scene",
      "bottom": 1260,
      "from": "syncViz",
      "params": { "title": "string", "bars": "number", "markers": "number[]" }
    },
    "suspense": {
      "status": "implemented",
      "kind": "overlay",
      "bottom": 0,
      "from": "suspense",
      "params": { "rings": "number", "x": "number", "y": "number" }
    }
  }
}
